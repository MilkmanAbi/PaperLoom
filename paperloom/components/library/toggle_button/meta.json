    {
      "name": "checked",
      "type": "bool",
      "default": false,
      "control": "checkbox"
    }
  ],
  "quick_properties": [
    "text"
  ],
  "signals": [
    {
      "name": "toggled",
      "stub": "on_{name}_toggled"
    }
  ]
}
