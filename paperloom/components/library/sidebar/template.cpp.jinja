{{ name }} = new QFrame(MainWindow);
{{ name }}->setObjectName("{{ name }}");
{{ name }}->setProperty("role", "sidebar");
{{ name }}->setGeometry({{ x }}, {{ y }}, {{ width }}, {{ height }});
{% if title %}auto *{{ name }}_title = new QLabel({{ name }});
{{ name }}_title->setObjectName("{{ name }}_title");
{{ name }}_title->setText("{{ title }}");
{{ name }}_title->setGeometry(12, 8, std::max(0, {{ width }} - 24), 22);
{{ name }}_title->setStyleSheet("font-weight: 600; font-size: 13px;");
{% endif %}
