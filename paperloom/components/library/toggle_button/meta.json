{
  "id": "toggle_button",
  "name": "Toggle button",
  "category": "buttons",
  "source": "default",
  "widget_class": "QPushButton",
  "qt_include": "QPushButton",
  "style_role": "button_secondary",
  "tags": [
    "button",
    "toggle",
    "checkable",
    "state"
  ],
  "description": "A button that stays pressed.",
