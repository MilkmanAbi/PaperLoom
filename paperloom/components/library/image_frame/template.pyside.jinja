self.{{ name }} = QLabel(MainWindow)
self.{{ name }}.setObjectName("{{ name }}")
self.{{ name }}.setProperty("role", "media_frame")
self.{{ name }}.setGeometry({{ x }}, {{ y }}, {{ width }}, {{ height }})
self.{{ name }}.setProperty("asset", "{{ asset }}")
self.{{ name }}.setProperty("fit", "{{ fit }}")
self.{{ name }}.setAlignment(Qt.AlignmentFlag.AlignCenter)
{% if asset_path %}self.{{ name }}.setPixmap(_fit_pixmap(_asset("{{ asset_path }}"), {{ width }}, {{ height }}, "{{ fit }}"))
self.{{ name }}.setScaledContents({{ "True" if fit == "stretch" else "False" }})
{% else %}self.{{ name }}.setText("Image"){% endif %}
