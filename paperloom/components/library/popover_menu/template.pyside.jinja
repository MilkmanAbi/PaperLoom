self.{{ name }} = QFrame(MainWindow)
self.{{ name }}.setObjectName("{{ name }}")
self.{{ name }}.setProperty("role", "popover")
self.{{ name }}.setGeometry({{ x }}, {{ y }}, {{ width }}, {{ height }})
{% for item in items.split(",") %}self.{{ name }}_item{{ loop.index0 }} = QLabel(self.{{ name }})
self.{{ name }}_item{{ loop.index0 }}.setObjectName("{{ name }}_item{{ loop.index0 }}")
self.{{ name }}_item{{ loop.index0 }}.setProperty("role", "popover_item")
self.{{ name }}_item{{ loop.index0 }}.setText("{{ item.strip() }}")
self.{{ name }}_item{{ loop.index0 }}.setGeometry(4, {{ loop.index0 * 28 + 4 }}, max(0, {{ width }} - 8), 26)
{% endfor %}
